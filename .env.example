# Web server
HERMES_WEBUI_HOST=127.0.0.1
HERMES_WEBUI_PORT=8787

# Hermes Gateway / API Server
HERMES_WEBUI_GATEWAY_BASE_URL=http://127.0.0.1:8642
HERMES_WEBUI_GATEWAY_API_KEY=
HERMES_WEBUI_DEFAULT_MODEL=default
HERMES_WEBUI_DEFAULT_PROVIDER=
HERMES_WEBUI_GATEWAY_READ_TIMEOUT=600s
HERMES_WEBUI_DEFAULT_WORKSPACE=
# Leave blank for loopback-only development. Password setup is stored server-side.
HERMES_WEBUI_TRUSTED_USER_HEADER=
HERMES_WEBUI_OIDC_ISSUER=
HERMES_WEBUI_PROFILES_JSON=

# Set true to use Hermes Runs API events, including interactive approvals.
HERMES_WEBUI_USE_RUNS_API=false

# Compatibility aliases are also supported:
# API_SERVER_KEY=
